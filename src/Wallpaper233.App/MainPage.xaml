<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Wallpaper233.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:core="using:Wallpaper233.Core"
    xmlns:local="using:Wallpaper233.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    DragOver="PageDragOver"
    Drop="PageDrop"
    mc:Ignorable="d">

    <Page.Resources>
        <local:LibraryThumbnailConverter x:Key="LibraryThumbnailConverter" />
        <local:VideoBadgeVisibilityConverter x:Key="VideoBadgeVisibilityConverter" />
    </Page.Resources>

    <NavigationView x:Name="Navigation"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Left"
                    IsPaneToggleButtonVisible="False"
                    SelectionChanged="NavigationSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="已安装" Tag="library" IsSelected="True">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Pictures" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="创意工坊" Tag="community">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Globe" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="设置" Tag="settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.Content>
            <Grid Padding="28" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid x:Name="LibraryView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="112" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="已安装壁纸" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock x:Name="LibrarySummaryText" Text="准备就绪" Opacity="0.68" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <TextBox x:Name="LibrarySearchBox"
                                     Width="210"
                                     PlaceholderText="搜索壁纸"
                                     TextChanged="LibrarySearchChanged" />
                            <ComboBox x:Name="LibrarySortComboBox"
                                      Width="138"
                                      SelectedIndex="0"
                                      SelectionChanged="LibrarySortChanged">
                                <ComboBoxItem Content="最近添加" />
                                <ComboBoxItem Content="名称" />
                            </ComboBox>
                            <Button Content="预览" Click="StartPreviewClick" />
                            <Button Content="应用到桌面" Click="ApplySelectedClick" />
                            <Button Content="导入文件" Click="ImportFilesClick" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            x:Name="DropZone"
                            AllowDrop="True"
                            DragOver="DropZoneDragOver"
                            Drop="DropZoneDrop"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xE898;" FontSize="22" VerticalAlignment="Center" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="拖入文件即可添加壁纸" FontSize="16" />
                                <TextBlock Text="支持图片、视频；双击卡片应用到桌面，右键查看更多操作" Opacity="0.68" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ListView x:Name="LibraryList"
                              Grid.Row="4"
                              SelectionMode="Single"
                              DoubleTapped="LibraryDoubleTapped"
                              Padding="0,0,0,12">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:LibraryItem">
                                <Border Width="224"
                                        Height="154"
                                        Margin="0,0,14,14"
                                        CornerRadius="10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Image Source="{Binding Converter={StaticResource LibraryThumbnailConverter}}"
                                               Stretch="UniformToFill" />
                                        <Border Background="#55000000" />
                                        <Border VerticalAlignment="Bottom"
                                                Padding="10,8"
                                                Background="#CC111111">
                                            <TextBlock Text="{x:Bind DisplayName}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Padding="7,4"
                                                CornerRadius="5"
                                                Background="#CC111111"
                                                Visibility="{x:Bind MediaKind, Converter={StaticResource VideoBadgeVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                <TextBlock Text="视频" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="应用到桌面" Tag="{x:Bind}" Click="ContextApplyClick" />
                                            <MenuFlyoutItem Text="安全预览" Tag="{x:Bind}" Click="ContextPreviewClick" />
                                            <MenuFlyoutItem Text="打开所在文件夹" Tag="{x:Bind}" Click="ContextOpenLocationClick" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid x:Name="CommunityView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="社区中心" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="Wallpaper233 社区优先；Steam Workshop 作为可选桥接。" Opacity="0.68" />
                    </StackPanel>
                    <Border Grid.Row="2" Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Wallpaper Engine Workshop" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="官方 Workshop 下载由 Steam Client 执行。Wallpaper233 不绕过 Steam，不内置非官方下载器；可以打开社区页面，或导入本机已经下载的内容。" TextWrapping="Wrap" Opacity="0.72" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="WorkshopInput" Width="420" PlaceholderText="粘贴 Workshop URL、ID 或搜索词" />
                                <Button Content="打开社区" Click="OpenWorkshopClick" />
                                <Button Content="扫描本机缓存" Click="ScanWorkshopClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <InfoBar x:Name="CommunityInfo" Grid.Row="4" IsOpen="True" Severity="Informational" Title="社区桥接" Message="没有 Steam 也能使用 Wallpaper233 本地库；Steam 功能是可选的。" />
                </Grid>

                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <TextBlock Text="设置" FontSize="30" FontWeight="SemiBold" />
                        <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="渲染与发布" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="控制面板使用稳定的 .NET 自包含发布；独立渲染进程使用 NativeAOT + Direct3D 12。" TextWrapping="Wrap" />
                                <TextBlock Text="网页壁纸运行时会单独隔离，避免 WebView2 的动态依赖影响主程序稳定性。" TextWrapping="Wrap" Opacity="0.68" />
                                <ComboBox x:Name="FitModeComboBox" Header="壁纸适配" SelectedIndex="0" SelectionChanged="FitModeChanged">
                                    <ComboBoxItem Content="裁剪铺满（推荐）" />
                                    <ComboBoxItem Content="完整显示" />
                                    <ComboBoxItem Content="拉伸填充" />
                                </ComboBox>
                                <CheckBox x:Name="RestoreOnLaunchCheckBox" Content="启动时恢复上次应用的壁纸" Click="RestoreOnLaunchClick" IsChecked="True" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView.Content>
    </NavigationView>
</Page>
